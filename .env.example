NODE_ENV=development
PORT=5000

# PostgreSQL connection string. Use the pooled Neon URL in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

JWT_SECRET=change-me-to-a-secure-jwt-secret-key-32-chars-min
JWT_REFRESH_SECRET=change-me-to-a-secure-refresh-secret-key-32-chars-min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="KootaFlow VSLA <noreply@kootaflow.com>"

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

ADMIN_NAME="KootaFlow Administrator"
ADMIN_EMAIL=admin@kootaflow.com
ADMIN_PASSWORD=change-this-password
